# ==============================================================================
# CipherChat — Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (apps/server & prisma)
# Host these on your persistent backend server (e.g., Render, Railway, AWS EC2)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://cipherchat:cipherchat@localhost:5432/cipherchat?schema=public"

# Optional Redis for distributed WebSocket coordination & presence
# REDIS_URL="redis://localhost:6379"

# Security & Session Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET="dev-jwt-access-secret-minimum-32-chars-long-change-in-prod"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-minimum-32-chars-long-change-in-prod"
COOKIE_SECRET="dev-cookie-secret-minimum-32-chars-long-change-in-prod"

# Allowed CORS & WebSocket Origins (comma-separated if multiple)
ALLOWED_ORIGINS="http://localhost:3000,https://cipherchat.netlify.app"

# Local encrypted blob storage path
UPLOAD_STORAGE_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# Host these on Netlify (Environment Variables settings)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_NAME="CipherChat"
